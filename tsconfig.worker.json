    "incremental": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": ".",
    "outDir": ".worker-dist",
    "isolatedModules": false,
    "plugins": []
  },
  "include": [
    "worker/export-jobs.ts",
    "worker/staff-push-dispatcher.ts"
  ],
  "exclude": [
