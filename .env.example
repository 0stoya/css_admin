# Magento origin, without a trailing slash.
MAGENTO_BASE_URL=https://staging.example.com

# Sent as the Magento GraphQL Store header.
MAGENTO_STORE_CODE=default

# Optional overrides. Leave blank to use MAGENTO_BASE_URL defaults.
# MAGENTO_GRAPHQL_URL=https://staging.example.com/graphql
# MAGENTO_ADMIN_TOKEN_URL=https://staging.example.com/rest/V1/integration/admin/token

# Trusted CSS Store origin used only for the fixed customer app-switch callback.
CSS_STORE_URL=https://store.csscdn.co.uk


# Trusted CSS kiosk origin used server-to-server to issue short-lived Employee RFID
# enrollment codes. No trailing slash.
CSS_KIOSK_BASE_URL=https://kiosk.csscdn.co.uk

# Must match css_kiosk. Server-side only; never expose through NEXT_PUBLIC_*.
KIOSK_EMPLOYEE_ENROLLMENT_SHARED_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Optional local Postgres read model for company finance snapshots.
# Server-side only; never expose through NEXT_PUBLIC_*.
# CSS_ADMIN_DATABASE_URL=postgresql://css_admin:password@127.0.0.1:5432/css_admin
# CSS_ADMIN_DATABASE_POOL_SIZE=5

# Optional direct OGL finance synchronisation. These values are used only
# server-side by scripts/finance-sync.mjs and must never be exposed publicly.
# CSS_ADMIN_OGL_API_URL=https://ogl-api.example.com
# CSS_ADMIN_OGL_API_KEY=REPLACE_WITH_OGL_API_KEY
# CSS_ADMIN_FINANCE_CURRENCY=GBP
# CSS_ADMIN_FINANCE_SYNC_CONCURRENCY=5
# CSS_ADMIN_FINANCE_SYNC_TIMEOUT_MS=25000
