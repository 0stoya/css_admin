# Magento origin, without a trailing slash.
MAGENTO_BASE_URL=https://staging.example.com

# Sent as the Magento GraphQL Store header.
MAGENTO_STORE_CODE=default

# Optional overrides. Leave blank to use MAGENTO_BASE_URL defaults.
# MAGENTO_GRAPHQL_URL=https://staging.example.com/graphql
# MAGENTO_ADMIN_TOKEN_URL=https://staging.example.com/rest/V1/integration/admin/token

# Magento GraphQL resilience/diagnostics. Server-side only.
# Requests fail closed after 15 seconds by default. Supported range: 1-60 seconds.
# MAGENTO_GRAPHQL_TIMEOUT_MS=15000
# Set to 1 to log operation timing; threshold 0 logs every operation.
# MAGENTO_GRAPHQL_TIMING=0
# MAGENTO_GRAPHQL_TIMING_THRESHOLD_MS=0

# Trusted CSS Store origin used only for the fixed customer app-switch callback.
CSS_STORE_URL=https://store.csscdn.co.uk


# Trusted CSS kiosk origin used server-to-server to issue short-lived Employee RFID
# enrollment codes. No trailing slash.
CSS_KIOSK_BASE_URL=https://kiosk.csscdn.co.uk

# Must match css_kiosk. Server-side only; never expose through NEXT_PUBLIC_*.
KIOSK_EMPLOYEE_ENROLLMENT_SHARED_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# TEMPORARY PRESENTATION BRIDGE — remove after the Fluid customer hierarchy API is deployed.
# Server-side only. The snapshot reader also enforces a maximum 14-day file lifetime.
# CSS_ADMIN_PORTAL_STRUCTURE_SNAPSHOT=/etc/css-admin/portal-company-structure.json

# Optional local Postgres read model for company finance snapshots.
# Server-side only; never expose through NEXT_PUBLIC_*.
# CSS_ADMIN_DATABASE_URL=postgresql://css_admin:password@127.0.0.1:5432/css_admin
# CSS_ADMIN_DATABASE_POOL_SIZE=5

# Finance source selector. Defaults to "fluid" when omitted.
# Keep production on "fluid" until the direct OGL Web Connector source is approved.
# CSS_ADMIN_FINANCE_SYNC_SOURCE=fluid
#
# Optional direct OGL finance synchronisation. These values are only used when
# CSS_ADMIN_FINANCE_SYNC_SOURCE=ogl and must never be exposed publicly.
# CSS_ADMIN_OGL_API_URL=https://ogl-api.example.com
# CSS_ADMIN_OGL_API_KEY=REPLACE_WITH_OGL_API_KEY
# CSS_ADMIN_FINANCE_CURRENCY=GBP
# CSS_ADMIN_FINANCE_SYNC_CONCURRENCY=5
# CSS_ADMIN_FINANCE_SYNC_TIMEOUT_MS=25000

# Optional background export jobs (Staff Admin). Disabled until the PostgreSQL
# migration and dedicated worker are deployed. These two settings belong ONLY
# in the Admin web process; keep worker Magento credentials in /etc/css-admin.
# CSS_ADMIN_EXPORT_JOBS_ENABLED=0
# CSS_ADMIN_EXPORT_DIR=/var/lib/css-admin/export-jobs

# Optional Staff user-bound Web Push for export-ready notifications.
# Requires migration 004 and a separate dedicated push dispatcher before enable.
# The public VAPID key is safe to serve to authenticated browsers; signing
# private key MUST remain only in /etc/css-admin/staff-push-worker.env (0600).
# CSS_ADMIN_PUSH_ENABLED=0
# CSS_ADMIN_PUSH_VAPID_PUBLIC_KEY=<65-byte base64url P-256 public key>
# CSS_ADMIN_PUSH_ENCRYPTION_KEY=<same server-side 32-byte base64url secret as dispatcher>
# DO NOT set CSS_ADMIN_PUSH_VAPID_PRIVATE_KEY in the web env or NEXT_PUBLIC_*.
